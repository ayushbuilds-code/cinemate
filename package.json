{
  "name": "cinemate",
  "version": "1.0.0",
  "description": "CineMate — Watch Together, Anywhere",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build && npm --prefix server install && npm --prefix server run build",
    "start": "npm --prefix server run start",
    "test": "npm --prefix server run test",
    "typecheck": "npm --prefix server run typecheck && npm --prefix client run typecheck"
  },
  "keywords": [
    "watch-party",
    "webrtc",
    "socketio",
    "video-call",
    "sync-playback"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7"
  }
}
